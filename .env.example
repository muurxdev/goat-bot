# ==========================================
# 🤖 GOAT BOT XP — CONFIGURAÇÃO DE PRODUÇÃO
# ==========================================

# Ambiente de execução: production | development | test
NODE_ENV=production

# Prefixo padrão dos comandos no WhatsApp
BOT_PREFIX=.

# Número do Dono do Bot (com DDD e formato WhatsApp)
# Exemplo: 5511999999999@s.whatsapp.net
BOT_OWNER_ID=SEUNUMERO@s.whatsapp.net

# Donos adicionais / sub-donos (separados por vírgula, sem espaços)
BOT_OWNER_IDS=

# Cooldown padrão entre comandos em milissegundos
DEFAULT_COOLDOWN_MS=2000

# Nível de logging: debug | info | warn | error
LOG_LEVEL=info
DEBUG=false

# Nome do diretório de sessão do Baileys
SESSION_NAME=sessao

# ==========================================
# 🎥 CONFIGURAÇÃO DE DOWNLOAD DE MÍDIA (yt-dlp)
# ==========================================

# Cookies Netscape do navegador (LOGADO no YouTube/TikTok/Instagram).
# Coloque o arquivo em data/cookies.txt (montado no container como /app/data/cookies.txt).
# Sem cookies, o YouTube bloqueia IPs de datacenter ("Sign in to confirm you're not a bot").
# Path customizado opcional:
# YOUTUBE_COOKIES_FILE=/app/data/cookies.txt

# Clientes do YouTube usados como fallback (separados por vírgula)
# YOUTUBE_CLIENTS=default,tv,android,ios,web_embedded

# PO Token do YouTube (opcional - gerado por ferramentas yt-dlp-get-pot).
# Ajuda a contornar o bloqueio sem cookies.
# YOUTUBE_PO_TOKEN=

# Fornecedor de PO Tokens (recomendado — tokens frescos por vídeo).
# A imagem brainicism/bgutil-ytdlp-pot-provider roda no compose e gera
# tokens dinâmicos durante cada extração, contornando o bot-check sem login.
# Descomente quando o serviço estiver no compose:
# YTDLP_EXTRACTOR_ARGS=youtubepot-bgutilhttp:base_url=http://bgutil-pot-provider:4416

# Diretório de plugins do yt-dlp (já embutido na imagem Docker)
# YTDLP_PLUGIN_DIR=/app/ytdlp_plugins

# ═══════════════════════════════════════════════════════════════
# 🧠 IA (opcional) — melhora .ia, .explicar, .resumo e .traduzir
# Sem nenhuma chave o bot continua funcionando: cai na busca web
# do DuckDuckGo e no tradutor literal, como sempre foi.
# Basta UMA. Todas têm free tier sem cartão de crédito.
# ═══════════════════════════════════════════════════════════════
# Google Gemini — o melhor gratuito; recomendado como principal.
# Chave grátis em https://aistudio.google.com/apikey
# Sem GEMINI_MODEL, o bot escolhe sozinho o "flash" estável mais novo da conta.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Groq — gratuito e muito rápido; bom como reserva do Gemini.
# Chave grátis em https://console.groq.com/keys
# Sem GROQ_MODEL, usa o melhor disponível (gpt-oss-120b, kimi-k2, llama-3.3-70b).
# GROQ_API_KEY=
# GROQ_MODEL=

# Cloudflare Workers AI — 10.000 neurons/dia.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE DRIVE — arquivos grandes (4K, playlists) por link
# ─────────────────────────────────────────────────────────────────────────────
# O WhatsApp entrega no maximo ~16 MB na galeria e 2 GB como documento (que nao
# aparece na galeria). Com o Drive ligado, o bot guarda o ORIGINAL em qualidade
# maxima e manda o link junto com uma previa tocavel.
#
# ATENCAO: NAO use Service Account. Ela tem cota propria de 15 GB e NAO herda o
# seu plano do Google One — upload grande falha com 403 storageQuotaExceeded.
# Use OAuth com refresh token da sua conta:
#
#   1. node scripts/google-drive-auth.js <CLIENT_ID> <CLIENT_SECRET>
#   2. node scripts/google-drive-check.js        (cria a pasta, imprime o ID)
#   3. node scripts/google-drive-check.js --upload  (teste real de ponta a ponta)
#
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
GDRIVE_FOLDER_NAME=GOAT Bot

# Teto de itens que o .playlist baixa de uma vez (protege a VPS)
PLAYLIST_MAX_ITENS=50
# Tempo maximo por video da playlist (30 min — um 4K longo demora)
PLAYLIST_ITEM_TIMEOUT_MS=1800000

# Espaco de disco que NUNCA e consumido por midia (banco, logs, sessao).
# A VPS tem ~22 GB livres; 3 GB de reserva evita que um download derrube o bot.
MEDIA_DISK_RESERVE_BYTES=3221225472

# ==========================================
# 💳 MERCADO PAGO — PAGAMENTO VIA PIX & ALUGUEL
# ==========================================
# Obtenha suas credenciais no painel de desenvolvedores do Mercado Pago
# https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_STATEMENT_DESCRIPTOR=GOAT
MERCADO_PAGO_WEBHOOK_URL=
